# Copy to .env and fill in real values. Never commit .env.

# --- Stratum listener (what cs-miner connects to) ---
LISTEN_ADDR=0.0.0.0:3532

# --- Upstream pool (real back-pool instance, PoW-only traffic relayed here) ---
UPSTREAM_POOL_ADDR=127.0.0.1:3332

# --- csd JSON-RPC ---
CSD_RPC_URL=http://127.0.0.1:26124
CSD_RPC_USER=troque-o-usuario-rpc
CSD_RPC_PASS=troque-a-senha-rpc

# --- Postgres (dedicated database, separate from back-pool's own DB) ---
DATABASE_URL=postgres://troque-o-usuario:troque-a-senha@127.0.0.1:5432/cs_stratum_bridge

# --- OPoI stake identity (private key must already be imported in csd's own wallet) ---
OPOI_ADDRESS=troque-pelo-endereco-de-stake
OPOI_COLLATERAL_TXID=
OPOI_COLLATERAL_VOUT=0
OPOI_ENDPOINT=
OPOI_MODEL_ID=

# --- Payout (defaults to OPOI_ADDRESS if unset; separate key must also be in csd's wallet if different) ---
PAYOUT_ADDRESS=
POOL_FEE_PERCENT=0
MIN_PAYOUT_CS=1.0

# --- HTTP prompt intake (requester-facing) ---
HTTP_LISTEN_ADDR=0.0.0.0:3533
OPOI_REQUESTER_API_KEY=troque-pela-chave-de-api

# --- Poll intervals (milliseconds) ---
POLL_INTERVAL_MS=15000
REVEAL_POLL_INTERVAL_MS=15000
RENEW_INTERVAL_MS=21600000
PAYOUT_INTERVAL_MS=3600000
