# Copy to .env and fill in real values. Never commit .env.

# --- Stratum listener (what cs-miner connects to) ---
LISTEN_ADDR=0.0.0.0:3532

# --- Upstream pool (real back-pool instance, PoW-only traffic relayed here) ---
UPSTREAM_POOL_ADDR=127.0.0.1:3332

# --- csd JSON-RPC ---
CSD_RPC_URL=http://127.0.0.1:26124
CSD_RPC_USER=troque-o-usuario-rpc
CSD_RPC_PASS=troque-a-senha-rpc

# --- Postgres (dedicated database, separate from back-pool's own DB) ---
# Optional. Leave unset/commented to use the bridge's OWN embedded Postgres
# instead (no external install/administration needed) — see
# EMBEDDED_DB_DATA_DIR/EMBEDDED_DB_PORT below. Only set this if you already
# run your own Postgres server and want the bridge to use it.
# DATABASE_URL=postgres://troque-o-usuario:troque-a-senha@127.0.0.1:5432/cs_stratum_bridge
EMBEDDED_DB_DATA_DIR=./bridge_pgdata
EMBEDDED_DB_PORT=5488

# --- OPoI stake identity (private key must already be imported in csd's own wallet) ---
# Comma-separated — NOT "OPOI_ADDRESS" (singular). This is required with no
# default (Config::parse() fails to start without it), so a typo'd var name
# here means the bridge silently never launches at all, not a soft failure.
OPOI_ADDRESSES=troque-pelo-endereco-de-stake
OPOI_COLLATERAL_TXID=
OPOI_COLLATERAL_VOUT=0
OPOI_ENDPOINT=
OPOI_MODEL_ID=

# --- Payout (defaults to OPOI_ADDRESS if unset; separate key must also be in csd's wallet if different) ---
PAYOUT_ADDRESS=
POOL_FEE_PERCENT=0
MIN_PAYOUT_CS=1.0

# --- HTTP prompt intake (requester-facing) ---
# Defaults to 0.0.0.0 so a real requester app (on another host) can reach
# it — but that means this port is reachable from anywhere your firewall
# allows, protected only by OPOI_REQUESTER_API_KEY (plus a per-IP rate
# limit on POST /cscoin/opoi/prompt). If your requester always runs on this
# same host, change this to 127.0.0.1:3533 instead. Either way, firewall
# this port from the public internet unless you specifically intend
# external requesters to reach it directly.
HTTP_LISTEN_ADDR=0.0.0.0:3533
OPOI_REQUESTER_API_KEY=troque-pela-chave-de-api

# --- Poll intervals (milliseconds) ---
POLL_INTERVAL_MS=15000
REVEAL_POLL_INTERVAL_MS=15000
RENEW_INTERVAL_MS=21600000
PAYOUT_INTERVAL_MS=3600000

# --- B3-lite (see src/opoi/b3lite.rs / b3lite_audit.rs) ---
# Empty B3LITE_RECEIPT_SECRET disables B3-lite entirely: no receipts are
# recorded/sampled/audited, zero behavior change from before this feature.
B3LITE_RECEIPT_SECRET=
B3LITE_AUDIT_SAMPLE_RATE=0.05
B3LITE_AUDIT_POLL_INTERVAL_MS=30000
# Local subprocess fallback — always available, no miner needs to be connected.
AUDITOR_CS_MINER_BIN=cs-miner
AUDITOR_CACHE_DIR=./auditor_cache
# Comma-separated wallets this operator trusts to run a real audit replay
# over stratum instead of (or before falling back to) the local subprocess
# above — empty means every audit runs via the local subprocess only.
AUDITOR_TRUSTED_WALLETS=

# --- D2 shard dispatch model sources (src/opoi/shard_engine.rs) ---
# A model resolved by NEITHER of the two mechanisms below is simply never
# shard-dispatched (same as having no manifest, no error logged).
#
# 1. Local override — JSON object, no network call, takes priority over the
#    marketplace lookup below when a model_id is present in both:
#    {"MODEL_ID":{"gguf_url":"...","tokenizer_url":"...","tokenizer_sha256":"..."}}
MODEL_SOURCES_JSON=
#
# 2. cs-marketplace catalog lookup (GET {url}/api/models/{model_id}) —
#    added so operators don't have to hand-write MODEL_SOURCES_JSON for
#    every model the D2 network supports. Cached in memory, 5min TTL.
#    Leave CS_MARKETPLACE_URL empty to disable (local override only).
CS_MARKETPLACE_URL=
CS_MARKETPLACE_TOKEN=

# --- Speculative decoding draft models (src/opoi/speculative_engine.rs) ---
# Optional — empty means speculative decoding is disabled for every target
# model (falls back to plain per-token dispatch). JSON object,
# {"TARGET_MODEL_ID":{"draft_model_id":"...","draft_gguf_url":"...","draft_gguf_sha256":"...","draft_tokenizer_url":"...","draft_tokenizer_sha256":"...","draft_total_layers":N}}
DRAFT_MODEL_SOURCES_JSON=

# --- cs-admin-manager live topology reporting (D2, 2026-07-26) ---
# Optional — empty ADMIN_REPORT_URL disables reporting entirely (this bridge
# never dials out). If set, this bridge periodically PUSHES its own live
# per-shard/per-expert topology there (push, not pull — this bridge may run
# on a network with no inbound reachability at all).
ADMIN_REPORT_URL=
ADMIN_REPORT_API_KEY=
# Defaults to this bridge's own effective payout address if unset.
ADMIN_REPORT_POOL_ID=
ADMIN_REPORT_INTERVAL_MS=8000
